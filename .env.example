# flow-nanobanana configuration
# Prefix: FLOW_

# Browser
FLOW_HEADLESS=true
FLOW_DELAY_MS=1500

# Paths
FLOW_OUTPUT_DIR=output
FLOW_SESSION_DIR=session

# Flow URL
FLOW_BASE_URL=https://labs.google/fx/es/tools/flow

# Credentials (para deploy/API — generar con: flow-nano --gen-key)
# FLOW_CREDENTIALS_KEY=
# FLOW_CREDENTIALS_FILE=session/credentials.enc
