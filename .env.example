# flow-nanobanana configuration
# Prefix: FLOW_

# Browser
FLOW_HEADLESS=true
FLOW_DELAY_MS=1500

# Paths
FLOW_OUTPUT_DIR=output
FLOW_IMAGE_QUALITY=1K            # 1K original, 2K/4K reescalado
FLOW_STRATEGY=auto               # auto | hybrid | classic (como se obtiene el resultado)
FLOW_AUTO_SNAPSHOT=true          # auto-capturar snapshot si cambia un selector critico
FLOW_VIDEO_MODEL=Veo 3.1 - Fast  # modelo de video para t2v
FLOW_VIDEO_TIMEOUT=480           # segundos de espera del video
FLOW_OUTPUT_RETENTION_DAYS=0     # 0 = conservar imagenes; >0 = borrar las mas viejas
FLOW_SESSION_DIR=session

# Flow URL
FLOW_BASE_URL=https://flow.google.com/

# Credentials (para deploy/API — generar con: flow-nano --gen-key)
# FLOW_CREDENTIALS_KEY=
# FLOW_ACCOUNT=           # forzar una cuenta (sin rotar)
